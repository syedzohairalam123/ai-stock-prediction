# Application Settings
APP_NAME=Neural Market API
APP_VERSION=2.3.0
DEBUG=false
LOG_LEVEL=INFO

# CORS Settings
CORS_ORIGINS=http://localhost:5173

# Core Settings
DEFAULT_PREDICTION_HORIZON=7
LIVE_POLL_SECONDS=20
MODEL_DIR=artifacts/models

# --- Phase 2: data provider layer ---
# Optional. Free key from https://finnhub.io/register — used only as a
# live-quote fallback/supplement to yfinance. The app works fine with this
# blank; it just runs on yfinance alone.
FINNHUB_API_KEY=
# Cache lifetimes in seconds — raise these if you're hitting provider rate limits.
HISTORY_CACHE_TTL_SECONDS=300
QUOTE_CACHE_TTL_SECONDS=20
PROFILE_CACHE_TTL_SECONDS=3600
PROVIDER_MAX_RETRIES=3
PROVIDER_TIMEOUT_SECONDS=30

# --- Phase 3: persistence ---
# SQLite by default (zero setup). Point this at a Postgres URL later
# (e.g. postgresql://user:pass@host/db) with no code changes needed.
DATABASE_URL=sqlite:///./neural_market.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Phase 14: AI market briefing (optional) ---
# Your own key from https://console.anthropic.com — blank means the
# /briefing endpoint reports itself as unavailable, nothing else breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=30

# --- Phase 19: rate limiting ---
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Phase 10: background jobs + notifications (all optional) ---
# How often the background loop runs (alert checks, prediction resolution,
# cache/rate-limiter cleanup). Set false to disable the loop entirely.
BACKGROUND_INTERVAL_SECONDS=300
BACKGROUND_JOBS_ENABLED=true
# How long fetched news headlines are cached before refetching.
NEWS_CACHE_TTL_SECONDS=600

# Telegram alert notifications — create a bot via @BotFather, then:
#   TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
#   TELEGRAM_CHAT_ID=123456789   (your chat id; ask @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# Email alert notifications via any SMTP server (Gmail app password, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TO=alerts@example.com
SMTP_FROM=you@gmail.com
SMTP_TIMEOUT_SECONDS=10
SMTP_USE_TLS=true

# Macro/events/crypto-pro/screener settings
FRED_API_KEY=
MACRO_DEFAULT_SOURCE=yfinance
CRYPTO_DEFAULT_SOURCE=coingecko
COINGECKO_TIMEOUT_SECONDS=15.0
SCREENER_DEFAULT_TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,XOM,GLD,BTC-USD
SCREENER_MAX_TICKERS=50

# Performance Settings
MAX_HISTORY_DAYS=3650
MIN_HISTORY_DAYS=30