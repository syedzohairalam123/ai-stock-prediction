# Application Settings
APP_NAME=Neural Market API
APP_VERSION=2.3.0
DEBUG=false
LOG_LEVEL=INFO

# CORS Settings
CORS_ORIGINS=http://localhost:5173

# Core Settings
DEFAULT_PREDICTION_HORIZON=7
LIVE_POLL_SECONDS=20
MODEL_DIR=artifacts/models

# --- Phase 2: data provider layer ---
# Optional. Free key from https://finnhub.io/register — used only as a
# live-quote fallback/supplement to yfinance. The app works fine with this
# blank; it just runs on yfinance alone.
FINNHUB_API_KEY=
# Cache lifetimes in seconds — raise these if you're hitting provider rate limits.
HISTORY_CACHE_TTL_SECONDS=300
QUOTE_CACHE_TTL_SECONDS=20
PROFILE_CACHE_TTL_SECONDS=3600
PROVIDER_MAX_RETRIES=3
PROVIDER_TIMEOUT_SECONDS=30

# --- Phase 15: live public forecast-market analysis ---
FORECAST_MARKET_TIMEOUT_SECONDS=15
FORECAST_MARKET_LIMIT=60

# --- Phase 14.1: real probability history (Polymarket CLOB price series) ---
# Public, keyless. Fidelity is the sampling granularity in minutes; TTL is the
# in-memory cache lifetime for a (token, window) pair.
FORECAST_CLOB_URL=https://clob.polymarket.com
FORECAST_HISTORY_TIMEOUT_SECONDS=15
FORECAST_HISTORY_CACHE_TTL_SECONDS=120
FORECAST_HISTORY_FIDELITY=60
FORECAST_HISTORY_MAX_POINTS=2000

# --- Phase 14.2: resolution tracking ---
FORECAST_RESOLUTION_CACHE_TTL_SECONDS=600
FORECAST_RESOLUTION_SCAN_LIMIT=200

# --- Phase 14.3: Monte-Carlo probability simulation ---
FORECAST_SIMULATION_PATHS=10000
FORECAST_SIMULATION_MAX_STEPS=180

# --- Phase 15: correlation-adjusted combination analysis ---
COMBINATION_MAX_EVENTS=12
COMBINATION_MIN_OVERLAP_POINTS=8
COMBINATION_MONTE_CARLO_DRAWS=20000
COMBINATION_SENSITIVITY_DELTA_PP=10

# --- Phase 3: persistence ---
# SQLite by default (zero setup). Point this at a Postgres URL later
# (e.g. postgresql://user:pass@host/db) with no code changes needed.
DATABASE_URL=sqlite:///./neural_market.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Phase 10: AI Financial Assistant ---
# Choose your AI provider: openai, openrouter, or anthropic
AI_PROVIDER=openai
# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_TOKENS=4000
# OpenRouter settings (alternative provider with multiple models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
# Anthropic settings (direct)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT_SECONDS=60
# AI assistant settings
AI_MAX_CONVERSATION_MESSAGES=50
AI_CONTEXT_WINDOW_TOKENS=8000
AI_ENABLE_STREAMING=true
AI_ENABLE_VOICE=true

# --- Phase 19: rate limiting ---
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Phase 10: background jobs + notifications (all optional) ---
# How often the background loop runs (alert checks, prediction resolution,
# cache/rate-limiter cleanup). Set false to disable the loop entirely.
BACKGROUND_INTERVAL_SECONDS=300
BACKGROUND_JOBS_ENABLED=true
# How long fetched news headlines are cached before refetching.
NEWS_CACHE_TTL_SECONDS=600

# Telegram alert notifications — create a bot via @BotFather, then:
#   TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
#   TELEGRAM_CHAT_ID=123456789   (your chat id; ask @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# Email alert notifications via any SMTP server (Gmail app password, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TO=alerts@example.com
SMTP_FROM=you@gmail.com
SMTP_TIMEOUT_SECONDS=10
SMTP_USE_TLS=true

# Macro/events/crypto-pro/screener settings
FRED_API_KEY=
MACRO_DEFAULT_SOURCE=yfinance
CRYPTO_DEFAULT_SOURCE=coingecko
COINGECKO_TIMEOUT_SECONDS=15.0
SCREENER_DEFAULT_TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,XOM,GLD,BTC-USD
SCREENER_MAX_TICKERS=50

# Phase 7 — Forex & commodities center. All optional: the sources below need no
# API key, so the page works with none of these set.
FX_RATES_CACHE_TTL_SECONDS=120
FX_HISTORY_CACHE_TTL_SECONDS=1800
EXCHANGERATE_API_URL=https://open.er-api.com/v6/latest/USD
EXCHANGERATE_API_TIMEOUT_SECONDS=15
# Freshness thresholds in seconds, measured against the SOURCE's publication
# time: <= live → LIVE, <= aging → DELAYED, beyond stale → UNAVAILABLE.
FX_LIVE_THRESHOLD_SECONDS=900
FX_AGING_THRESHOLD_SECONDS=86400
FX_STALE_THRESHOLD_SECONDS=604800

# Phase 8 — Professional News & Financial Intelligence Desk
# Real news APIs for comprehensive financial news coverage.
# Get free API keys from:
# - NewsAPI: https://newsapi.org/register (100 requests/day free)
# - Alpha Vantage: https://www.alphavantage.co/support/#api-key (25 requests/day free)
# - Finnhub news uses the same key as quotes (already configured above)
NEWSAPI_KEY=
NEWSAPI_URL=https://newsapi.org/v2
NEWSAPI_TIMEOUT_SECONDS=15

ALPHA_VANTAGE_KEY=
ALPHA_VANTAGE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_TIMEOUT_SECONDS=15

# News aggregation settings
FINNHUB_NEWS_CACHE_TTL_SECONDS=300
NEWS_MAX_ITEMS_PER_REQUEST=100
NEWS_DEFAULT_PAGE_SIZE=20
NEWS_SEARCH_DEBOUNCE_MS=300

# --- Phase 8 addendum: keyless publisher feeds + analytics ---
# These need NO API key. With all the keys above empty, the desk still fills
# itself from real publisher RSS/Atom feeds.
NEWS_RSS_ENABLED=true
# PK | GLOBAL | ALL — which feed regions to ingest.
NEWS_DEFAULT_REGION=ALL
# Simultaneous outbound feed requests (politeness cap, not a throughput dial).
NEWS_FETCH_CONCURRENCY=6
# How often the background loop ingests news (seconds).
NEWS_REFRESH_INTERVAL_SECONDS=1800
# Tickers to pull company-scoped news for on every ingest (empty to disable).
NEWS_SYMBOL_WATCHLIST=OGDC,PPL,LUCK,HBL,UBL,MCB,MEBL,ENGRO,FFC,PSO,SYS,HUBC,MARI,BAFL,NETSOL
NEWS_SYMBOL_MAX=20

# Near-duplicate suppression: rows scanned, MinHash geometry, Jaccard cut-off.
NEWS_DEDUPE_SCAN_LIMIT=3000
NEWS_MINHASH_ROWS=24
NEWS_MINHASH_BAND_ROWS=4
NEWS_DEDUPE_JACCARD_THRESHOLD=0.8
# Cheap corroborating fingerprint (kept alongside the MinHash signature).
NEWS_SIMHASH_BANDS=4
NEWS_SIMHASH_HAMMING_THRESHOLD=3

# Search ranking (BM25).
NEWS_SEARCH_TITLE_BOOST=2.5
NEWS_SEARCH_FUZZY=true

# Performance Settings
MAX_HISTORY_DAYS=3650
MIN_HISTORY_DAYS=30

# --- Phase 16: Advanced Live Perpetual Futures Analytics + Paper Simulation Engine ---
# Derivatives data providers
DERIVATIVES_ENABLE_YFINANCE_PROVIDER=true
DERIVATIVES_ENABLE_BINANCE_PROVIDER=true
# Cache settings
DERIVATIVES_QUOTE_CACHE_TTL_SECONDS=20
DERIVATIVES_HISTORY_CACHE_TTL_SECONDS=300
DERIVATIVES_FUNDING_CACHE_TTL_SECONDS=60
DERIVATIVES_OI_CACHE_TTL_SECONDS=60
DERIVATIVES_DEPTH_CACHE_TTL_SECONDS=10
# WebSocket settings
DERIVATIVES_ENABLE_WEBSOCKET=true
DERIVATIVES_WS_HEARTBEAT_INTERVAL_SECONDS=30
DERIVATIVES_WS_STALE_CONNECTION_TIMEOUT_SECONDS=300
DERIVATIVES_WS_MAX_RECONNECTION_ATTEMPTS=5
DERIVATIVES_WS_RECONNECTION_BACKOFF_BASE_SECONDS=2
# Analytics settings
DERIVATIVES_ANALYTICS_DEFAULT_LOOKBACK_DAYS=30
DERIVATIVES_ANALYTICS_MAX_LOOKBACK_DAYS=365
# Paper simulation settings
DERIVATIVES_SIMULATION_MAX_LEVERAGE=100
DERIVATIVES_SIMULATION_MAX_SCENARIOS_PER_USER=50
# Data quality settings
DERIVATIVES_DATA_QUALITY_MAX_AGE_SECONDS=300
DERIVATIVES_DATA_QUALITY_FRESHNESS_THRESHOLD_SECONDS=60

# --- Phase 17: Real-Time Breaking News + Trending Topics + Market Impact Intelligence ---
# Breaking detection settings
BREAKING_NEWS_BREAKING_THRESHOLD=75.0
BREAKING_NEWS_SIGNIFICANT_THRESHOLD=50.0
BREAKING_NEWS_RECENCY_WINDOW_HOURS=24
BREAKING_NEWS_BREAKING_RECENCY_MINUTES=30
BREAKING_NEWS_SIGNIFICANT_RECENCY_HOURS=6
# Deduplication settings
BREAKING_NEWS_SIMHASH_THRESHOLD=3
BREAKING_NEWS_SIMILARITY_THRESHOLD=0.85
BREAKING_NEWS_MIN_SOURCES_FOR_CLUSTER=2
# Topic settings
BREAKING_NEWS_TOPIC_TREND_WINDOW_HOURS=1
BREAKING_NEWS_MIN_TOPIC_MENTIONS=3
BREAKING_NEWS_MAX_TOPICS=50
# Market impact settings
BREAKING_NEWS_DEFAULT_OBSERVATION_WINDOW=1h
# WebSocket settings
BREAKING_NEWS_ENABLE_WEBSOCKET=true
BREAKING_NEWS_WS_HEARTBEAT_INTERVAL_SECONDS=30
BREAKING_NEWS_WS_STALE_CONNECTION_TIMEOUT_SECONDS=300
BREAKING_NEWS_WS_MAX_RECONNECTION_ATTEMPTS=5
BREAKING_NEWS_WS_RECONNECTION_BACKOFF_BASE_SECONDS=2
# Cache settings
BREAKING_NEWS_BREAKING_NEWS_CACHE_TTL_SECONDS=60
BREAKING_NEWS_TOPICS_CACHE_TTL_SECONDS=300
BREAKING_NEWS_MARKET_IMPACT_CACHE_TTL_SECONDS=120
# AI summarization settings
BREAKING_NEWS_ENABLE_AI_SUMMARIZATION=true
BREAKING_NEWS_AI_SUMMARY_MAX_LENGTH=200