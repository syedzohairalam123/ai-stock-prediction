# Phase 1 fix: these used to be hardcoded to 127.0.0.1 in the source code,
# which meant a deployed frontend kept calling your laptop instead of the
# real deployed backend. Copy this file to `.env` and point both at your
# actual backend URL when you deploy (e.g. your Render service URL).

VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true
VITE_AUTO_REFRESH_ENABLED=true
VITE_DEFAULT_REFRESH_INTERVAL=20000
